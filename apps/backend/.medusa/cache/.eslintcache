sa-shop/apps/backend/src/modules/file-supabase/service.ts",[],[],{"ruleId":"119","severity":1,"message":"120","line":5,"column":36,"nodeType":"121","messageId":"122","endLine":5,"endColumn":44,"fix":"123"},{"ruleId":"124","severity":1,"message":"125","line":5,"column":17,"nodeType":"126","messageId":"127","endLine":5,"endColumn":50,"suggestions":"128"},{"ruleId":"124","severity":1,"message":"125","line":11,"column":17,"nodeType":"126","messageId":"127","endLine":11,"endColumn":54,"suggestions":"129"},{"ruleId":"124","severity":1,"message":"125","line":26,"column":23,"nodeType":"126","messageId":"127","endLine":26,"endColumn":88,"suggestions":"130"},{"ruleId":"124","severity":1,"message":"125","line":49,"column":23,"nodeType":"126","messageId":"127","endLine":49,"endColumn":86,"suggestions":"131"},"@medusajs/prefer-container-registration-keys","Use `ContainerRegistrationKeys.LOGGER` instead of the magic string `logger`.","Literal","preferRegistrationKey",{"range":"132","text":"133"},"@medusajs/use-medusa-error-not-generic-error","Throw `MedusaError` instead of a generic `Error`. Use `new MedusaError(MedusaError.Types.X, \"...\")` so the error maps to the correct HTTP status.","NewExpression","useMedusaError",["134"],["135"],["136"],["137"],[0,250],"import { ContainerRegistrationKeys } from \"@medusajs/framework/utils\"\nimport type { MedusaRequest, MedusaResponse } from \"@medusajs/framework/http\"\nimport { sendTelegramPhoto } from \"../../../lib/telegram\"\n\nexport async function POST(req: MedusaRequest, res: MedusaResponse) {\n  const logger = req.scope.resolve(ContainerRegistrationKeys.LOGGER",{"messageId":"138","data":"139","fix":"140","desc":"141"},{"messageId":"138","data":"142","fix":"143","desc":"141"},{"messageId":"138","data":"144","fix":"145","desc":"141"},{"messageId":"138","data":"146","fix":"147","desc":"141"},"replaceWithMedusaError",{"type":"148"},{"range":"149","text":"150"},"Replace with `new MedusaError(MedusaError.Types.UNEXPECTED_STATE, ...)` (pick the appropriate `MedusaError.Types.*`).",{"type":"148"},{"range":"151","text":"152"},{"type":"148"},{"range":"153","text":"154"},{"type":"148"},{"range":"155","text":"156"},"MedusaError.Types.UNEXPECTED_STATE",[0,148],"import { MedusaError } from \"@medusajs/framework/utils\"\nconst TG_API = \"https://api.telegram.org\"\n\nfunction token() {\n  const t = process.env.TG_BOT_TOKEN\n  if (!t) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"TG_BOT_TOKEN not set\")",[0,277],"import { MedusaError } from \"@medusajs/framework/utils\"\nconst TG_API = \"https://api.telegram.org\"\n\nfunction token() {\n  const t = process.env.TG_BOT_TOKEN\n  if (!t) throw new Error(\"TG_BOT_TOKEN not set\")\n  return t\n}\n\nfunction chatId() {\n  const c = process.env.TG_ADMIN_CHAT_ID\n  if (!c) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"TG_ADMIN_CHAT_ID not set\")",[0,716],"import { MedusaError } from \"@medusajs/framework/utils\"\nconst TG_API = \"https://api.telegram.org\"\n\nfunction token() {\n  const t = process.env.TG_BOT_TOKEN\n  if (!t) throw new Error(\"TG_BOT_TOKEN not set\")\n  return t\n}\n\nfunction chatId() {\n  const c = process.env.TG_ADMIN_CHAT_ID\n  if (!c) throw new Error(\"TG_ADMIN_CHAT_ID not set\")\n  return c\n}\n\nexport async function sendTelegramMessage(text: string) {\n  const res = await fetch(`${TG_API}/bot${token()}/sendMessage`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({\n      chat_id: chatId(),\n      text,\n      parse_mode: \"Markdown\",\n    }),\n  })\n  const data = await res.json()\n  if (!data.ok) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, `Telegram sendMessage failed: ${JSON.stringify(data)}`)",[0,1366],"import { MedusaError } from \"@medusajs/framework/utils\"\nconst TG_API = \"https://api.telegram.org\"\n\nfunction token() {\n  const t = process.env.TG_BOT_TOKEN\n  if (!t) throw new Error(\"TG_BOT_TOKEN not set\")\n  return t\n}\n\nfunction chatId() {\n  const c = process.env.TG_ADMIN_CHAT_ID\n  if (!c) throw new Error(\"TG_ADMIN_CHAT_ID not set\")\n  return c\n}\n\nexport async function sendTelegramMessage(text: string) {\n  const res = await fetch(`${TG_API}/bot${token()}/sendMessage`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({\n      chat_id: chatId(),\n      text,\n      parse_mode: \"Markdown\",\n    }),\n  })\n  const data = await res.json()\n  if (!data.ok) throw new Error(`Telegram sendMessage failed: ${JSON.stringify(data)}`)\n  return data.result\n}\n\nexport async function sendTelegramPhoto(\n  file: { buffer: Buffer; filename: string; mimetype: string },\n  caption?: string\n) {\n  const form = new FormData()\n  form.append(\"chat_id\", chatId())\n  if (caption) {\n    form.append(\"caption\", caption)\n    form.append(\"parse_mode\", \"Markdown\")\n  }\n\n  const blob = new Blob([file.buffer], { type: file.mimetype })\n  form.append(\"photo\", blob, file.filename)\n\n  const res = await fetch(`${TG_API}/bot${token()}/sendPhoto`, {\n    method: \"POST\",\n    body: form,\n  })\n  const data = await res.json()\n  if (!data.ok) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, `Telegram sendPhoto failed: ${JSON.stringify(data)}`)"]